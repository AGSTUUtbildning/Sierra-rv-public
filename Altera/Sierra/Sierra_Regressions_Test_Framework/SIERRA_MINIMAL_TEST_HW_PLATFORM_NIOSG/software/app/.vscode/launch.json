            "miDebuggerPath": "/home/ludvig/altera_lite/25.1std/riscfree/toolchain/riscv32-unknown-elf/bin/riscv32-unknown-elf-gdb",
            "miDebuggerServerAddress": "localhost:23870",
            "useExtendedRemote": true,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "setting GDB command timeout increase if the target connection is slow",
                    "text": "set remotetimeout 5000",
                    "ignoreFailures": true
                },
                {
                    "description": "setting tcp connection timeout in seconds",
                    "text": "set tcp connect-timeout 90",
                    "ignoreFailures": true
                },
                {
                    "description": "setting tcp retry using tcp connect-timeout",
                    "text": "set tcp auto-retry on",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable non-stop mode",
                    "text": "set non-stop on",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable async mode",
                    "text": "set target-async on",
                    "ignoreFailures": true
                }
            ],
            "postRemoteConnectCommands": [
                {
                    "description": "Remove the default break at main inserted by cppdbg",
                    "text": "delete 1",
                    "ignoreFailures": true
                },
                {
                    "description": "Load command",
                    "text": "load",
                    "ignoreFailures": true
                },
                {
                    "description": "Break at main",
                    "text": "-break-insert -t main",
                    "ignoreFailures": true
                },
                {
                    "description": "Set mstatus",
                    "text": "set $mstatus = 0x1800",
                    "ignoreFailures": true
                },
                {
                    "description": "Import custom instruction module",
                    "text": "python import gdb.custominsn",
                    "ignoreFailures": true
                },
                {
                    "description": "Source custom instruction Python file",
                    "text": "source /home/ludvig/altera_lite/25.1std/riscfree/toolchain/riscv32-unknown-elf/share/gdb/python/gdb/custominsn.py",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable custom instruction display",
                    "text": "set custom-instruction-display on",
                    "ignoreFailures": true
                },
                {
                    "description": "Show custom instruction display status",
                    "text": "show custom-instruction-display",
                    "ignoreFailures": true
                },
                {
                    "description": "Set custom instruction filename",
                    "text": "set custom-instruction-filename /home/ludvig/altera_lite/25.1std/riscfree/debugger/gdbserver-riscv/niosv_custom_instr.xml ",
                    "ignoreFailures": true
                },
                {
                    "description": "continue",
                    "text": "continue",
                    "ignoreFailures": true
                }
            ],
            "debugServerPath": "/home/ludvig/altera_lite/25.1std/riscfree/debugger/gdbserver-riscv/ash-riscv-gdb-server",
            "debugServerArgs": "--gdb-port 23870 --transport-type jtag  --jtag-frequency 16000KHz",
            "serverLaunchTimeout": 5000
