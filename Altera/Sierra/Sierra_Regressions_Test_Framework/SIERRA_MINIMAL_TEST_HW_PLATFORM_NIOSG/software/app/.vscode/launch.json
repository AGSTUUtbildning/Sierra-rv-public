{
    "configurations": [
        {
            "logging": {
                "engineLogging": "error"
            },
            "name": "test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:askProgramPath}",
            "args": [],
            "stopAtConnect": true,
            "stopAtEntry": true,
            "cwd": "/home/ludvig/fpga/altera/projects/sierra/SIERRA_MINIMAL_TEST_HW_PLATFORM_NIOSG/sierra_niosvg_archive_restored/software/app",
            "environment": [],
            "externalConsole": false,
