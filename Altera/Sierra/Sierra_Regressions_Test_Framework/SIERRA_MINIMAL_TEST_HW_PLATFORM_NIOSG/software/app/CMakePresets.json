{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-release-ninja",
      "displayName": "Windows Release (Ninja)",
      "description": "Build app.elf and the BSP with the Intel Nios V RISC-V toolchain on Windows.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-win-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../hal_bsp/toolchain-windows.cmake"
      }
    },
    {
      "name": "windows-release-mingw",
      "displayName": "Windows Release (MinGW Makefiles)",
      "description": "Fallback Windows build when Ninja is not installed.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-win-release-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../hal_bsp/toolchain-windows.cmake"
      }
    },
    {
      "name": "windows-release-make",
      "displayName": "Windows Release (Intel Make)",
      "description": "Fallback Windows build using make.exe bundled with Intel RISCFree build tools.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-win-release-make",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../hal_bsp/toolchain-windows.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release-ninja",
      "configurePreset": "windows-release-ninja"
    },
    {
      "name": "windows-release-mingw",
      "configurePreset": "windows-release-mingw"
    },
    {
      "name": "windows-release-make",
      "configurePreset": "windows-release-make"
    }
  ]
}
